{
  "name": "@4mbl/components",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./.css": "./dist/assets/components.css"
  },
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "4mbl",
  "homepage": "https://github.com/4mbl/components/#readme",
  "keywords": [
    "react",
    "components"
  ],
  "scripts": {
    "ci": "pnpm run build && pnpm run format:check && pnpm run typecheck && pnpm run lint",
    "dev": "vite",
    "build": "vite build --config vite.config.ts",
    "build:app": "vite build --config vite-app.config.ts",
    "lint": "eslint src/lib",
    "format:check": "prettier --check src/lib",
    "format:write": "prettier --write src/lib",
    "typecheck": "tsc",
    "preview:app": "vite preview",
    "local-release": "changeset version && changeset publish",
    "prepublishOnly": "pnpm run ci"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "glob": "^13.0.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "unplugin-dts": "^1.1.1",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": "24.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.0",
      "onFail": "download"
    }
  }
}
